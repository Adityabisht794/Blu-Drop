<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6F7"
    tools:context=".MainActivity">

    <!-- Top Chat App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back arrow placeholder -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="20sp"
            android:textColor="#444444" />

        <!-- Chat title + subtitle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BluDrop Chat"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvChatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearby secure Bluetooth chat"
                android:textSize="11sp"
                android:textColor="#888888" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Call / info icons placeholder -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="ⓘ"
            android:textSize="16sp"
            android:textColor="#888888" />
    </LinearLayout>

    <!-- Status chip (uses tvStatus id) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Status: Bluetooth OFF"
        android:textSize="12sp"
        android:textColor="#B94A3A"
        android:padding="8dp"
        android:background="@drawable/bg_status_chip"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp" />

    <!-- Rounded action buttons row -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnEnableBluetooth"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Enable Bluetooth"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6F61" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnScanConnect"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Scan &amp; Connect"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FF6F61"
            android:backgroundTint="#FFE8E4" />
    </LinearLayout>

    <!-- Chat messages area (scrollable) -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="72dp"
        app:layout_constraintTop_toBottomOf="@id/layoutButtons"
        app:layout_constraintBottom_toTopOf="@id/layoutMessageRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Simple column; tvChatLog ko bubbles jaisa style de diya -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:textColor="#333333"
                android:padding="8dp"
                android:background="@drawable/bg_chat_log"
                android:layout_marginBottom="4dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom message input bar -->
    <LinearLayout
        android:id="@+id/layoutMessageRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#FFFFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Attachment icon placeholder -->
        <TextView
            android:id="@+id/tvPlus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="+"
            android:textSize="18sp"
            android:textColor="#FF6F61" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:hint="Type something..."
            android:maxLines="4"
            android:background="@drawable/bg_input_chat"
            android:padding="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="➤"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6F61" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
